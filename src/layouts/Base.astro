---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Travis Galloway',
  description = 'Senior Engineering Leader. Building platforms and teams at scale.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Travis Galloway" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://travisgalloway.com" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Travis Galloway" />
    <meta property="og:image" content="https://travisgalloway.com/images/og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://travisgalloway.com/images/og.jpg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/favicon-512.png" />
    <title>{title}</title>
    <script is:inline>
      (function() {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <link rel="canonical" href="https://travisgalloway.com" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Travis Galloway",
      "url": "https://travisgalloway.com",
      "jobTitle": "Senior Engineering Manager",
      "description": "Senior Engineering Leader. Building platforms and teams at scale.",
      "worksFor": { "@type": "Organization", "name": "Target" },
      "sameAs": [
        "https://linkedin.com/in/travis-galloway",
        "https://github.com/travisgalloway"
      ]
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>
